<!-- Privacy Unboxing Section — Interactive Outer/Inner Toggle -->
<section class="privacy-unboxing section-pad" id="discretion" style="position:relative;overflow:hidden;background:linear-gradient(to bottom, var(--bg-deep), #090e17, var(--bg-deep));border-top:1px solid var(--border-gold);">

  <!-- Ambient glow -->
  <div style="pointer-events:none;position:absolute;left:50%;top:50%;width:450px;height:450px;border-radius:50%;background:rgba(197,160,89,0.05);filter:blur(120px);transform:translate(-50%,-50%);"></div>

  <div class="container" style="position:relative;z-index:1;">

    <div class="section-header">
      <div style="display:inline-flex;align-items:center;gap:8px;border-radius:100px;border:1px solid rgba(197,160,89,0.3);background:rgba(197,160,89,0.1);padding:6px 16px;margin-bottom:16px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c5a059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold-light);">100% Discreet Packaging Covenant</span>
      </div>
      <h2 class="section-title">Zero Product Name <em>On Outer Box.</em></h2>
      <p class="section-desc">We respect your privacy above all else. Every 30ml Midnight Drive order is shipped in a plain, unbranded outer parcel. Family members, roommates, or courier riders will never know what is inside.</p>
    </div>

    <!-- Toggle Buttons -->
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:40px;">
      <button type="button" id="unboxing-outer-btn" class="unboxing-tab-btn unboxing-tab-btn--active" onclick="switchUnboxing('outer')">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/></svg>
        1. Outer Box (What Courier &amp; Family Sees)
      </button>
      <button type="button" id="unboxing-inner-btn" class="unboxing-tab-btn" onclick="switchUnboxing('inner')">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        2. Inside Box (Your Private 30ml Bottle)
      </button>
    </div>

    <!-- Interactive Display -->
    <div style="display:grid;gap:32px;margin-top:40px;align-items:center;">
      <style>@media(min-width:1024px){.unboxing-display-grid{grid-template-columns:7fr 5fr !important;}}</style>
      <div class="unboxing-display-grid" style="display:grid;gap:32px;align-items:center;">

        <!-- Visual Panel -->
        <div>
          <!-- Outer Box View -->
          <div id="unboxing-outer-panel" class="unboxing-panel unboxing-panel--visible">
            <div style="border-radius:24px;border:1px solid rgba(197,160,89,0.3);background:#070a10;padding:40px;text-align:center;box-shadow:0 25px 80px rgba(0,0,0,0.8);">
              <div style="position:relative;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;width:240px;height:200px;border-radius:16px;border:2px dashed rgba(92,102,117,0.4);background:#121927;padding:24px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#8c97a8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/></svg>
                <span style="font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#9aa4b5;margin-top:12px;">Plain Cardboard Parcel</span>
                <span style="margin-top:6px;border-radius:6px;background:#070b12;padding:4px 12px;font-family:var(--font-mono);font-size:9px;color:var(--gold);">"Personal Healthcare Item"</span>
                <div style="position:absolute;top:10px;right:10px;border-radius:6px;border:1px solid rgba(197,160,89,0.4);background:rgba(9,14,23,0.9);padding:4px 8px;font-family:var(--font-mono);font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold-light);">Confidential COD</div>
              </div>
              <div style="margin-top:20px;display:inline-flex;align-items:center;gap:8px;border-radius:100px;border:1px solid rgba(74,222,128,0.3);background:rgba(74,222,128,0.1);padding:8px 16px;font-size:12px;color:#4ade80;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                100% Anonymous Delivery — Zero Brand Name Outside
              </div>
            </div>
          </div>

          <!-- Inner Bottle View -->
          <div id="unboxing-inner-panel" class="unboxing-panel">
            <div style="border-radius:24px;border:1px solid rgba(197,160,89,0.3);background:#070a10;padding:40px;text-align:center;box-shadow:0 25px 80px rgba(0,0,0,0.8);">
              <div style="display:flex;flex-direction:column;align-items:center;">
                <!-- Bottle illustration -->
                <div style="width:100px;height:200px;position:relative;display:flex;flex-direction:column;align-items:center;">
                  <div style="width:16px;height:24px;background:linear-gradient(135deg,#8B6914,#c5a059);border-radius:4px 4px 0 0;"></div>
                  <div style="width:40px;height:8px;background:linear-gradient(135deg,#5a4209,#8B6914);"></div>
                  <div style="flex:1;width:80px;background:linear-gradient(135deg,#2a1a05 0%,#8B6914 30%,#c5a059 50%,#8B6914 70%,#2a1a05 100%);border-radius:8px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(197,160,89,0.5);">
                    <div style="text-align:center;padding:8px;">
                      <div style="font-family:var(--font-heading);font-size:8px;letter-spacing:0.15em;color:var(--cream);text-transform:uppercase;">Midnight</div>
                      <div style="font-family:var(--font-heading);font-size:8px;letter-spacing:0.15em;color:var(--gold);text-transform:uppercase;">Drive</div>
                      <div style="font-family:var(--font-mono);font-size:6px;color:var(--cream);margin-top:2px;">30ml</div>
                    </div>
                  </div>
                </div>
                <div style="margin-top:20px;display:inline-flex;align-items:center;gap:8px;border-radius:100px;border:1px solid rgba(197,160,89,0.4);background:rgba(197,160,89,0.15);padding:8px 16px;font-family:var(--font-mono);font-size:11px;font-weight:700;color:var(--gold-light);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c5a059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  Midnight Drive 30ml Amber Glass Dropper
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Text Details -->
        <div style="display:flex;flex-direction:column;gap:16px;">
          <div class="unboxing-detail-card">
            <div class="unboxing-detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div>
              <h4 class="unboxing-detail-title">Plain Outer Shipping Box</h4>
              <p class="unboxing-detail-desc">No mention of "vitality", "oil", or "men's aura" on the outside parcel label.</p>
            </div>
          </div>
          <div class="unboxing-detail-card">
            <div class="unboxing-detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            </div>
            <div>
              <h4 class="unboxing-detail-title">Discreet Rider Delivery</h4>
              <p class="unboxing-detail-desc">Handed directly to you via TCS / Trax rider in a sealed tamper-proof bag.</p>
            </div>
          </div>
          <div class="unboxing-detail-card">
            <div class="unboxing-detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h4 class="unboxing-detail-title">Confidential Invoice</h4>
              <p class="unboxing-detail-desc">Invoice is placed inside the inner box, invisible from outside parcel.</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
.unboxing-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 16px;
  border: 1px solid rgba(197,160,89,0.3);
  background: #090e17;
  padding: 12px 20px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--slate);
  cursor: pointer;
  transition: all 0.3s;
}
.unboxing-tab-btn:hover { border-color: rgba(197,160,89,0.6); color: var(--cream); }
.unboxing-tab-btn--active {
  border-color: var(--gold);
  background: var(--gold);
  color: var(--bg-deep);
  box-shadow: 0 0 20px rgba(197,160,89,0.35);
}
.unboxing-panel { display: none; }
.unboxing-panel--visible { display: block; }
.unboxing-detail-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  border-radius: 16px;
  border: 1px solid rgba(197,160,89,0.2);
  background: #090e17;
  padding: 20px;
}
.unboxing-detail-icon {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: rgba(197,160,89,0.15);
  color: var(--gold-light);
}
.unboxing-detail-title {
  font-family: var(--font-serif);
  font-size: 15px;
  font-weight: 600;
  color: var(--cream);
  margin-bottom: 4px;
}
.unboxing-detail-desc { font-size: 12px; color: var(--slate); line-height: 1.6; }
</style>

<script>
function switchUnboxing(mode) {
  var outerBtn = document.getElementById('unboxing-outer-btn');
  var innerBtn = document.getElementById('unboxing-inner-btn');
  var outerPanel = document.getElementById('unboxing-outer-panel');
  var innerPanel = document.getElementById('unboxing-inner-panel');
  if (!outerBtn) return;
  if (mode === 'outer') {
    outerBtn.classList.add('unboxing-tab-btn--active');
    innerBtn.classList.remove('unboxing-tab-btn--active');
    outerPanel.classList.add('unboxing-panel--visible');
    innerPanel.classList.remove('unboxing-panel--visible');
  } else {
    innerBtn.classList.add('unboxing-tab-btn--active');
    outerBtn.classList.remove('unboxing-tab-btn--active');
    innerPanel.classList.add('unboxing-panel--visible');
    outerPanel.classList.remove('unboxing-panel--visible');
  }
}
</script>

{% schema %}
{
  "name": "Privacy Unboxing",
  "class": "privacy-unboxing-section",
  "tag": "div",
  "settings": [],
  "presets": [{ "name": "Privacy Unboxing" }]
}
{% endschema %}
