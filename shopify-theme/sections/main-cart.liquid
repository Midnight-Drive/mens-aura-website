<!-- Main Cart Page Section -->
<section class="main-cart-page section-pad" style="background:var(--bg-deep);min-height:75vh;padding:48px 0 80px;">
  <div class="container" style="max-width:920px;">

    <!-- Section Header -->
    <div class="section-header" style="text-align:left;margin-bottom:32px;">
      <div style="display:inline-flex;align-items:center;gap:8px;border-radius:100px;border:1px solid rgba(197,160,89,0.3);background:rgba(197,160,89,0.1);padding:5px 14px;margin-bottom:12px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c5a059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold-light);">Step 2 of 3 · Your Shopping Cart</span>
      </div>
      <h1 style="font-family:var(--font-serif);font-size:32px;font-weight:600;color:var(--cream);margin:0;">Your Shopping Cart</h1>
      <p style="font-family:var(--font-mono);font-size:11px;color:var(--slate);letter-spacing:0.1em;text-transform:uppercase;margin-top:6px;">
        Free Discreet Delivery &amp; Cash on Delivery Across Pakistan
      </p>
    </div>

    {% if cart.item_count > 0 %}
      <!-- Calculate Cart-wide MRP Compare At Price & Total Savings -->
      {% assign cart_original_total = 0 %}
      {% for item in cart.items %}
        {% assign item_bottle_count = 1 %}
        {% if item.variant.title contains '3' or item.title contains '3 Bottle' or item.variant.title contains 'Master' %}
          {% assign item_bottle_count = 3 %}
        {% elsif item.variant.title contains '2' or item.title contains '2 Bottle' or item.variant.title contains 'Pack' %}
          {% assign item_bottle_count = 2 %}
        {% else %}
          {% assign item_bottle_count = 1 %}
        {% endif %}

        {% assign unit_compare = item.variant.compare_at_price %}
        {% if unit_compare == blank or unit_compare <= item.final_price %}
          {% assign unit_compare = item_bottle_count | times: 300000 %}
        {% endif %}
        {% assign item_total_compare = unit_compare | times: item.quantity %}
        {% assign cart_original_total = cart_original_total | plus: item_total_compare %}
      {% endfor %}
      {% assign cart_total_savings = cart_original_total | minus: cart.total_price %}

      <form action="/cart" method="post" id="cart-page-form">
        <div style="border-radius:24px;border:1px solid rgba(197,160,89,0.25);background:#090e17;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.6);">

          <!-- Items list -->
          <div style="padding:28px 32px;">
            {% for item in cart.items %}
              {% assign item_bottle_count = 1 %}
              {% if item.variant.title contains '3' or item.title contains '3 Bottle' or item.variant.title contains 'Master' %}
                {% assign item_bottle_count = 3 %}
              {% elsif item.variant.title contains '2' or item.title contains '2 Bottle' or item.variant.title contains 'Pack' %}
                {% assign item_bottle_count = 2 %}
              {% else %}
                {% assign item_bottle_count = 1 %}
              {% endif %}

              {% assign unit_compare = item.variant.compare_at_price %}
              {% if unit_compare == blank or unit_compare <= item.final_price %}
                {% assign unit_compare = item_bottle_count | times: 300000 %}
              {% endif %}
              {% assign total_item_compare = unit_compare | times: item.quantity %}
              {% assign item_savings = total_item_compare | minus: item.final_line_price %}

              <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0;{% unless forloop.last %}border-bottom:1px solid rgba(197,160,89,0.15);{% endunless %}flex-wrap:wrap;">
                
                <!-- Left: Image & Info -->
                <div style="display:flex;align-items:flex-start;gap:20px;flex:1;min-width:260px;">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" style="width:76px;height:76px;object-fit:cover;border-radius:14px;border:1px solid rgba(197,160,89,0.25);flex-shrink:0;">
                  {% else %}
                    <div style="width:76px;height:76px;border-radius:14px;background:#0d1422;border:1px solid rgba(197,160,89,0.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c5a059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </div>
                  {% endif %}
                  <div>
                    <h3 style="font-family:var(--font-serif);font-size:18px;font-weight:600;color:var(--cream);margin:0 0 4px;">{{ item.product.title }}</h3>
                    
                    {% unless item.variant.title contains 'Default' %}
                      <div style="display:inline-block;border-radius:6px;background:rgba(197,160,89,0.15);border:1px solid rgba(197,160,89,0.3);padding:2px 8px;font-family:var(--font-mono);font-size:10px;letter-spacing:0.05em;color:var(--gold-light);margin-bottom:6px;">
                        {{ item.variant.title }}
                      </div>
                    {% endunless %}

                    <!-- Pricing & Savings Badges -->
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:4px;">
                      <span style="font-family:var(--font-mono);font-size:13px;font-weight:700;color:var(--gold-light);">
                        {{ item.final_price | money_without_currency | prepend: 'PKR ' }}
                      </span>
                      {% if total_item_compare > item.final_line_price %}
                        <span style="font-family:var(--font-mono);font-size:12px;color:var(--slate);text-decoration:line-through;">
                          {{ unit_compare | money_without_currency | prepend: 'PKR ' }}
                        </span>
                      {% endif %}
                      {% if item_savings > 0 %}
                        <span style="border-radius:4px;background:rgba(34,197,94,0.15);border:1px solid rgba(34,197,94,0.35);color:#4ade80;padding:1px 6px;font-family:var(--font-mono);font-size:10px;font-weight:700;">
                          SAVE {{ item_savings | money_without_currency | prepend: 'PKR ' }}
                        </span>
                      {% endif %}
                    </div>

                    <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#ef4444;display:inline-block;margin-top:10px;text-decoration:underline;">
                      Remove item
                    </a>
                  </div>
                </div>

                <!-- Right: Quantity Selector & Line Total -->
                <div style="display:flex;align-items:center;gap:24px;justify-content:flex-end;">
                  <!-- Quantity -->
                  <div style="display:inline-flex;align-items:center;border-radius:10px;border:1px solid rgba(197,160,89,0.3);background:#070b12;">
                    <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" style="padding:6px 14px;color:var(--gold);font-weight:bold;text-decoration:none;transition:color 0.2s;" aria-label="Decrease quantity">−</a>
                    <span style="font-family:var(--font-mono);font-size:13px;padding:0 8px;color:var(--cream);font-weight:600;">{{ item.quantity }}</span>
                    <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" style="padding:6px 14px;color:var(--gold);font-weight:bold;text-decoration:none;transition:color 0.2s;" aria-label="Increase quantity">+</a>
                  </div>

                  <!-- Line Total -->
                  <div style="text-align:right;min-width:110px;">
                    <div style="font-family:var(--font-heading);font-size:17px;font-weight:700;color:var(--gold-light);">
                      {{ item.final_line_price | money_without_currency | prepend: 'PKR ' }}
                    </div>
                    {% if total_item_compare > item.final_line_price %}
                      <div style="font-family:var(--font-mono);font-size:11px;color:var(--slate);text-decoration:line-through;">
                        {{ total_item_compare | money_without_currency | prepend: 'PKR ' }}
                      </div>
                    {% endif %}
                  </div>
                </div>

              </div>
            {% endfor %}
          </div>

          <!-- Summary Breakdown & Checkout Footer -->
          <div style="background:#06090f;padding:28px 32px;border-top:1px solid rgba(197,160,89,0.25);display:flex;flex-direction:column;gap:18px;">
            
            <h4 style="font-family:var(--font-serif);font-size:16px;color:var(--cream);margin:0;letter-spacing:0.05em;">Order Summary</h4>

            <!-- Breakdown Rows -->
            <div style="display:flex;flex-direction:column;gap:10px;padding-bottom:16px;border-bottom:1px dashed rgba(197,160,89,0.2);">
              
              <!-- Original Total MRP -->
              {% if cart_original_total > cart.total_price %}
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--slate);">
                  <span>Original Value (MRP):</span>
                  <span style="font-family:var(--font-mono);text-decoration:line-through;">
                    {{ cart_original_total | money_without_currency | prepend: 'PKR ' }}
                  </span>
                </div>
              {% endif %}

              <!-- Total Bundle Discount -->
              {% if cart_total_savings > 0 %}
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;color:#4ade80;">
                  <span style="display:flex;align-items:center;gap:6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    Promotional Savings:
                  </span>
                  <span style="font-family:var(--font-mono);font-weight:700;">
                    − {{ cart_total_savings | money_without_currency | prepend: 'PKR ' }}
                  </span>
                </div>
              {% endif %}

              <!-- Nationwide Shipping -->
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--slate);">
                <span>Discreet Nationwide Delivery:</span>
                <span style="font-family:var(--font-mono);color:var(--gold-light);font-weight:600;">FREE (Cash on Delivery)</span>
              </div>
            </div>

            <!-- Final Payable Total -->
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <div>
                <span style="font-family:var(--font-serif);font-size:20px;font-weight:600;color:var(--cream);">Total Payable (COD):</span>
                <span style="display:block;font-size:11px;color:var(--slate);margin-top:2px;">No prepayment required. Pay courier at your doorstep.</span>
              </div>
              <div style="text-align:right;">
                <span style="font-family:var(--font-heading);font-size:26px;font-weight:800;color:var(--gold-light);">
                  {{ cart.total_price | money_without_currency | prepend: 'PKR ' }}
                </span>
                {% if cart_total_savings > 0 %}
                  <div style="font-family:var(--font-mono);font-size:10px;color:#4ade80;font-weight:600;margin-top:2px;">
                    You save {{ cart_total_savings | money_without_currency | prepend: 'PKR ' }} on this order
                  </div>
                {% endif %}
              </div>
            </div>

            <!-- Discreet Assurance Banner -->
            <div style="border-radius:12px;border:1px solid rgba(197,160,89,0.2);background:rgba(9,14,23,0.8);padding:12px 16px;display:flex;align-items:center;gap:12px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c5a059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <p style="font-size:11px;line-height:1.5;color:var(--slate);margin:0;">
                <strong style="color:var(--cream);">100% Discreet Packaging Covenant:</strong> Delivered in a sealed, unbranded flyer. Courier riders and family will never know the contents.
              </p>
            </div>

            <!-- Action Buttons -->
            <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;margin-top:8px;">
              <a href="/" style="font-family:var(--font-mono);font-size:11px;text-transform:uppercase;letter-spacing:0.15em;color:var(--slate);text-decoration:none;transition:color 0.2s;">
                ← Continue Shopping
              </a>
              <button type="submit" name="checkout" class="gold-glow-button" style="padding:16px 36px;font-size:12px;letter-spacing:0.2em;display:inline-flex;align-items:center;gap:10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                <span>PROCEED TO CHECKOUT</span>
              </button>
            </div>

          </div>

        </div>
      </form>
    {% else %}
      <div style="border-radius:24px;border:1px solid rgba(197,160,89,0.25);background:#090e17;padding:64px 32px;text-align:center;">
        <div style="width:64px;height:64px;border-radius:50%;border:1px solid rgba(197,160,89,0.3);background:rgba(197,160,89,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;color:var(--gold-light);">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--cream);">Your cart is currently empty.</h2>
        <p style="font-size:14px;color:var(--slate);margin-top:8px;">Experience Midnight Drive 30ml — handcrafted for male vitality.</p>
        <div style="margin-top:28px;">
          <a href="/products/midnight-drive-by-mens-aura" class="gold-glow-button" style="display:inline-flex;padding:14px 28px;font-size:11px;display:inline-flex;align-items:center;gap:8px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span>View Midnight Drive (PKR 2,499)</span>
          </a>
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "class": "main-cart-section",
  "tag": "div",
  "settings": []
}
{% endschema %}
