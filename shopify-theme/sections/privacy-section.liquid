<!-- Privacy / Discreet Packaging Section -->
<section class="privacy-section">
  <div class="container">

    <div class="section-header">
      <p class="section-eyebrow">Your Privacy, Guaranteed</p>
      <h2 class="section-title">Delivered With <em>Complete Discretion</em></h2>
      <p class="section-desc">Every aspect of your order is designed with your privacy as the top priority.</p>
    </div>

    <div class="privacy-grid" style="margin-top:40px;">

      <div class="privacy-card">
        <div class="privacy-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3 class="privacy-card__title">Plain Brown Box</h3>
        <p class="privacy-card__desc">Zero product names, brand logos, or any descriptions on the exterior shipping label.</p>
      </div>

      <div class="privacy-card">
        <div class="privacy-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        </div>
        <h3 class="privacy-card__title">Cash on Delivery</h3>
        <p class="privacy-card__desc">Pay cash to the courier at your door. No online payment, no card details needed.</p>
      </div>

      <div class="privacy-card">
        <div class="privacy-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <h3 class="privacy-card__title">Nationwide Delivery</h3>
        <p class="privacy-card__desc">Fast delivery via TCS or Trax across all of Pakistan — typically 48–72 hours.</p>
      </div>

      <div class="privacy-card">
        <div class="privacy-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="privacy-card__title">100% Safe Formula</h3>
        <p class="privacy-card__desc">Cold-pressed botanical actives only. Zero synthetic chemicals or harmful substances.</p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Privacy Section",
  "class": "privacy-section-wrapper",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Privacy Section"
    }
  ]
}
{% endschema %}
