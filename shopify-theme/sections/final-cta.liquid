<!-- Final Grand CTA Section -->
<section class="final-cta">
  <div class="final-cta__glow" aria-hidden="true"></div>

  <div class="container" style="position:relative;z-index:1;">

    <!-- Stallion Mark SVG -->
    <svg class="stallion-mark" style="margin:0 auto;" aria-hidden="true" viewBox="0 0 44 48" fill="none">
      <defs>
        <linearGradient id="stallionGold" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#f5dfa8"/>
          <stop offset="50%" stop-color="#c5a059"/>
          <stop offset="100%" stop-color="#9e7a36"/>
        </linearGradient>
      </defs>
      <path d="M9 42c3.8-5.8 5.2-11.8 5-17.7C13.8 15.6 17.8 7.6 29.2 3c-.4 3.6.8 6.5 3.4 8.8 2.8 2.5 4.7 5.4 4.7 9.4 0 5.3-3.2 8.9-7.6 11.4-3.3 1.9-6.1 4.3-8.1 8.1"
        stroke="url(#stallionGold)" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M18 15.2c2.8-2.3 6.3-3.4 10.5-3.4M19.8 19.2c4.4 0 8.3 1.4 11.7 4.2M15 28.3c4.6.2 8.5 1.4 11.8 3.7M12.8 35.3c3.1.4 5.8 1.2 8.1 2.7M29.4 3c3.2 1.4 6.1 3.8 8.3 7.4"
        stroke="url(#stallionGold)" stroke-width="1.4" stroke-linecap="round"/>
      <path d="m34.6 12.6 4.5 1.1-3.5 2.1M30.2 31.7l4.8 1.4-4.4 1.3"
        stroke="url(#stallionGold)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <span class="final-cta__eyebrow">Your Night, On Your Terms</span>

    <h2 class="final-cta__title">
      Keep something extraordinary<br>
      <em>for yourself.</em>
    </h2>

    <p class="final-cta__desc">
      Order Midnight Drive today. Delivered across Pakistan in a plain, unmarked box — no one will know what is inside. Pay cash when it arrives at your door. Feel the difference from night one.
    </p>

    <div style="display:flex;justify-content:center;">
      <a href="/products/midnight-drive-by-mens-aura" class="gold-glow-button final-cta__btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        ORDER NOW — PKR 2,499
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>

