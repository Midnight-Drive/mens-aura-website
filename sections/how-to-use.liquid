<!-- How To Use Section — 3 Step Night Ritual -->
<section class="how-to-use section-pad" id="ritual" style="background:linear-gradient(to bottom, var(--bg-darker), var(--bg-deep));border-top:1px solid var(--border-gold);">
  <div class="container">

    <div class="section-header">
      <div style="display:inline-flex;align-items:center;gap:8px;border-radius:100px;border:1px solid rgba(197,160,89,0.3);background:rgba(197,160,89,0.1);padding:6px 16px;margin-bottom:16px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c5a059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold-light);">Easy Daily Night Routine</span>
      </div>
      <h2 class="section-title">How To Apply <em>For Best Results.</em></h2>
      <p class="section-desc">Follow this simple 3-step application routine every night before sleeping.</p>
    </div>

    <!-- 3 Steps Grid -->
    <div class="ritual-grid" style="display:grid;gap:24px;margin-top:48px;">
      <style>@media(min-width:640px){.ritual-grid{grid-template-columns:repeat(3,1fr);}}</style>

      <!-- Step 01 -->
      <div class="ritual-step-card">
        <div class="ritual-step-num">01</div>
        <h3 class="ritual-step-title">Apply 4–5 Drops</h3>
        <p class="ritual-step-desc">
          Apply 4 to 5 drops directly on the male shaft area. <strong style="color:var(--gold-light)">Note:</strong> Avoid applying on the top tip (head/glans) area.
        </p>
        <p class="ritual-step-urdu" dir="rtl">
          ۴ سے ۵ قطرے عضومخصوص کے نچلے حصّے پر لگائیں۔ (اوپری سِرے کو چھوڑ کر)
        </p>
      </div>

      <!-- Step 02 -->
      <div class="ritual-step-card">
        <div class="ritual-step-num">02</div>
        <h3 class="ritual-step-title">Gentle Night Massage</h3>
        <p class="ritual-step-desc">
          Gently massage for 2 to 3 minutes until fully absorbed. Leave on overnight and wash off normally in the morning.
        </p>
        <p class="ritual-step-urdu" dir="rtl">
          ۲ سے ۳ منٹ ہلکے ہاتھوں سے مالش کریں تاکہ جذب ہو جائے۔ رات بھر لگا رہنے دیں اور صبح نہا لیں۔
        </p>
      </div>

      <!-- Step 03 -->
      <div class="ritual-step-card">
        <div class="ritual-step-num">03</div>
        <h3 class="ritual-step-title">100% Safe &amp; Natural</h3>
        <p class="ritual-step-desc">
          Pure herbal formulation with Raig Mahi, Clove &amp; Ostrich Oil. Completely safe for daily use with <strong style="color:var(--cream)">zero side effects</strong>.
        </p>
        <p class="ritual-step-urdu" dir="rtl">
          ریگ ماہی، لونگ اور شتر مرغ کا ۱۰۰٪ قدرتی فارمولا۔ روزانہ استعمال کے لیے مکمل محفوظ اور بے ضرر۔
        </p>
      </div>

    </div>

    <!-- Important Precaution Banner -->
    <div class="precaution-banner" style="margin-top:32px;">
      <div style="display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;">
        <div style="width:40px;height:40px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:12px;background:rgba(197,160,89,0.2);color:var(--gold-light);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div style="flex:1;">
          <h4 style="font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold-light);">
            Important Precaution Notice / ضروری احتیاطی تدبیر
          </h4>
          <p style="margin-top:6px;font-size:14px;line-height:1.7;color:#dbe2ee;">
            <strong style="color:var(--cream)">Do NOT engage in intimate contact while the oil is applied.</strong> Always wash and clean the area thoroughly with water before any intimate relations.
          </p>
          <p style="margin-top:8px;font-size:13px;line-height:1.7;color:var(--gold-light);text-align:right;" dir="rtl">
            اہم احتیاط: تیل لگا کر مباشرت (ہمبستری) بالکل نہ کریں۔ کسی بھی تعلق سے پہلے پانی سے اچھی طرح دھو لیں۔
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.ritual-step-card {
  border-radius: 24px;
  border: 1px solid rgba(197,160,89,0.25);
  background: #090e17;
  padding: 28px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10px 40px rgba(0,0,0,0.4);
}
.ritual-step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 14px;
  border: 1px solid rgba(197,160,89,0.4);
  background: rgba(197,160,89,0.15);
  font-family: var(--font-mono);
  font-size: 18px;
  font-weight: 700;
  color: var(--gold-light);
  margin-bottom: 20px;
}
.ritual-step-title {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 600;
  color: var(--cream);
  margin-bottom: 12px;
}
.ritual-step-desc {
  font-size: 13px;
  line-height: 1.75;
  color: var(--slate);
  margin-bottom: 12px;
}
.ritual-step-urdu {
  font-size: 12px;
  line-height: 1.8;
  color: var(--gold-light);
  text-align: right;
  width: 100%;
  margin-top: 8px;
  font-weight: 500;
}
.precaution-banner {
  border-radius: 16px;
  border: 1px solid rgba(197,160,89,0.4);
  background: linear-gradient(135deg, #141b29 0%, #1a2336 50%, #141b29 100%);
  padding: 24px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.4);
}
</style>

