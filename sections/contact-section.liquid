<!-- Contact Section — Contact Page -->
<section class="contact-section section-pad" id="contact" style="background:linear-gradient(to bottom, var(--bg-deep), #0b101a, var(--bg-deep));border-top:1px solid var(--border-gold);">
  <div class="container">

    <div class="section-header">
      <div style="display:inline-flex;align-items:center;gap:8px;border-radius:100px;border:1px solid rgba(197,160,89,0.3);background:rgba(197,160,89,0.1);padding:6px 16px;margin-bottom:16px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c5a059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold-light);">100% Confidential Support Concierge</span>
      </div>
      <h2 class="section-title">Contact <em>The Men's Aura.</em></h2>
      <p class="section-desc">Have a question about Midnight Drive, discreet packaging, or order tracking? Reach our private support concierge anytime via WhatsApp or Email.</p>
    </div>

    <div class="contact-grid" style="display:grid;gap:32px;margin-top:48px;">
      <style>
        @media(min-width:1024px){ .contact-grid { grid-template-columns: 5fr 7fr !important; gap: 48px !important; } }
      </style>

      <!-- Left Column: Official Support Channels -->
      <div style="display:flex;flex-direction:column;gap:24px;">

        <!-- WhatsApp Support Card -->
        <div style="border-radius:24px;border:1px solid rgba(197,160,89,0.3);background:#090e17;padding:32px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 15px 50px rgba(0,0,0,0.5);">
          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <div style="width:48px;height:48px;border-radius:14px;border:1px solid rgba(197,160,89,0.4);background:rgba(197,160,89,0.15);display:flex;align-items:center;justify-content:center;color:var(--gold-light);box-shadow:0 0 20px rgba(197,160,89,0.2);">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              </div>
              <span style="display:inline-flex;align-items:center;gap:6px;border-radius:100px;border:1px solid rgba(197,160,89,0.4);background:rgba(197,160,89,0.1);padding:4px 12px;font-family:var(--font-mono);font-size:10px;color:var(--gold-light);">
                <span style="width:6px;height:6px;border-radius:50%;background:var(--gold);animation:pulse 2s infinite;"></span> Direct Concierge
              </span>
            </div>
            <h3 style="font-family:var(--font-serif);font-size:22px;font-weight:600;color:var(--cream);margin-top:20px;">Official WhatsApp Support</h3>
            <p style="font-family:var(--font-mono);font-size:14px;font-weight:700;color:var(--gold);margin-top:4px;">+92 311 0355 309</p>
            <p style="font-size:12px;line-height:1.7;color:var(--slate);margin-top:8px;">
              Text-only WhatsApp support. Message us for fast order confirmation, shipment tracking, or usage advice. Responds within 15 minutes.
            </p>
          </div>
          <div style="margin-top:28px;border-top:1px solid rgba(197,160,89,0.2);padding-top:20px;">
            <a href="https://wa.me/923110355309?text=Hello%20The%20Men's%20Aura%20Support%2C%20I%20have%20a%20question%20about%20Midnight%20Drive"
               target="_blank" rel="noopener noreferrer" class="gold-glow-button" style="width:100%;justify-content:center;padding:14px;font-size:11px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              <span>Order &amp; Chat on WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Email Support Card -->
        <div style="border-radius:24px;border:1px solid rgba(197,160,89,0.3);background:#090e17;padding:32px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 15px 50px rgba(0,0,0,0.5);">
          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <div style="width:48px;height:48px;border-radius:14px;border:1px solid rgba(197,160,89,0.4);background:rgba(197,160,89,0.15);display:flex;align-items:center;justify-content:center;color:var(--gold-light);">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <span style="font-family:var(--font-mono);font-size:10px;color:var(--slate);">Email Concierge</span>
            </div>
            <h3 style="font-family:var(--font-serif);font-size:22px;font-weight:600;color:var(--cream);margin-top:20px;">Official Email Support</h3>
            <p style="font-family:var(--font-mono);font-size:12px;font-weight:700;color:var(--gold);margin-top:4px;">support@themensauraofficial.com</p>
            <p style="font-size:12px;line-height:1.7;color:var(--slate);margin-top:8px;">
              Dedicated email concierge for detailed inquiries, bulk orders, and private client support. Replies within 2 to 4 hours.
            </p>
          </div>
          <div style="margin-top:28px;border-top:1px solid rgba(197,160,89,0.15);padding-top:20px;">
            <a href="mailto:support@themensauraofficial.com"
               style="display:flex;align-items:center;justify-content:center;gap:8px;border-radius:12px;border:1px solid rgba(197,160,89,0.4);background:#0d1422;padding:14px;font-family:var(--font-mono);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--gold-light);transition:background 0.3s;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span>Send Official Email</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Confidential Direct Message Form -->
      <div>
        <div style="border-radius:24px;border:1px solid rgba(197,160,89,0.3);background:#090e17;padding:32px 36px;box-shadow:0 20px 70px rgba(0,0,0,0.6);">
          <div style="display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:11px;color:var(--gold);text-transform:uppercase;letter-spacing:0.15em;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            100% Private Message Box
          </div>
          <h3 style="font-family:var(--font-serif);font-size:28px;font-weight:600;color:var(--cream);margin-top:8px;">Send a Direct Message</h3>
          <p style="font-size:12px;color:var(--slate);margin-top:6px;line-height:1.6;">
            Fill out the form below. Your contact details are kept strictly confidential under our Privacy Policy.
          </p>

          {% form 'contact', class: 'contact-form', style: 'margin-top:28px;display:flex;flex-direction:column;gap:20px;' %}
            {% if form.posted_successfully? %}
              <div style="border-radius:16px;border:1px solid rgba(197,160,89,0.4);background:#0d1524;padding:32px;text-align:center;">
                <div style="margin:0 auto;width:56px;height:56px;border-radius:50%;border:1px solid rgba(197,160,89,0.4);background:rgba(197,160,89,0.15);display:flex;align-items:center;justify-content:center;color:var(--gold-light);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                </div>
                <h4 style="font-family:var(--font-serif);font-size:22px;font-weight:600;color:var(--cream);margin-top:16px;">Message Sent Successfully!</h4>
                <p style="font-size:13px;line-height:1.7;color:var(--slate);margin-top:8px;">
                  Thank you. Our private customer concierge will review your message and respond via WhatsApp or Email within 15 minutes.
                </p>
              </div>
            {% else %}
              {% if form.errors %}
                <div style="border-radius:12px;border:1px solid #ef4444;background:rgba(239,68,68,0.1);padding:14px;color:#fca5a5;font-size:12px;">
                  {{ form.errors | default_errors }}
                </div>
              {% endif %}

              <div class="form-row-2" style="display:grid;gap:20px;">
                <style>@media(min-width:640px){.form-row-2{grid-template-columns:1fr 1fr;}}</style>
                <div>
                  <label for="ContactFormName" style="display:block;font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.15em;color:var(--gold);margin-bottom:8px;">Your Name *</label>
                  <input type="text" id="ContactFormName" name="contact[name]" required placeholder="e.g. Ali Ahmed"
                         style="width:100%;border-radius:12px;border:1px solid rgba(197,160,89,0.25);background:#070b12;padding:14px 16px;font-size:14px;color:var(--cream);outline:none;">
                </div>
                <div>
                  <label for="ContactFormPhone" style="display:block;font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.15em;color:var(--gold);margin-bottom:8px;">WhatsApp / Phone *</label>
                  <input type="tel" id="ContactFormPhone" name="contact[phone]" required placeholder="03xx xxxxxxx"
                         style="width:100%;border-radius:12px;border:1px solid rgba(197,160,89,0.25);background:#070b12;padding:14px 16px;font-size:14px;color:var(--cream);outline:none;">
                </div>
              </div>

              <div>
                <label for="ContactFormEmail" style="display:block;font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.15em;color:var(--gold);margin-bottom:8px;">Email Address (Optional)</label>
                <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="your.email@domain.com"
                       style="width:100%;border-radius:12px;border:1px solid rgba(197,160,89,0.25);background:#070b12;padding:14px 16px;font-size:14px;color:var(--cream);outline:none;">
              </div>

              <div>
                <label for="ContactFormMessage" style="display:block;font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.15em;color:var(--gold);margin-bottom:8px;">Your Message / Inquiry *</label>
                <textarea rows="4" id="ContactFormMessage" name="contact[body]" required placeholder="Write your question about product usage, discreet delivery, or order status..."
                          style="width:100%;border-radius:12px;border:1px solid rgba(197,160,89,0.25);background:#070b12;padding:14px 16px;font-size:14px;color:var(--cream);outline:none;resize:vertical;"></textarea>
              </div>

              <button type="submit" class="gold-glow-button" style="width:100%;justify-content:center;padding:16px;font-size:12px;letter-spacing:0.2em;margin-top:6px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                <span>Send Message to Support</span>
              </button>
            {% endif %}
          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Section",
  "class": "contact-section-wrapper",
  "tag": "div",
  "settings": [],
  "presets": [{ "name": "Contact Section" }]
}
{% endschema %}
