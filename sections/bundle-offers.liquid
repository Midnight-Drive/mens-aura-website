<style>
.bundle-card {
  border-radius: 24px;
  border: 1px solid rgba(197,160,89,0.25);
  background: #090e17;
  padding: 24px 28px;
  display: flex;
  flex-direction: column;
  gap: 0;
  transition: border-color 0.3s, transform 0.3s;
  cursor: pointer;
}
.bundle-card:hover { border-color: rgba(197,160,89,0.5); transform: translateY(-4px); }
.bundle-card--popular {
  border: 2px solid var(--gold);
  background: linear-gradient(to bottom, #111929, #090e17, #111929);
  box-shadow: 0 0 40px rgba(197,160,89,0.2);
  transform: scale(1.02);
}
.bundle-card--popular:hover { transform: scale(1.02) translateY(-4px); }
.bundle-badge {
  display: inline-block;
  border-radius: 100px;
  border: 1px solid;
  padding: 4px 14px;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 20px;
}
.bundle-title {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 600;
  color: var(--cream);
  margin-bottom: 4px;
}
.bundle-subtitle {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--slate);
  margin-bottom: 20px;
}
.bundle-price-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
  border-top: 1px solid var(--border-gold);
  border-bottom: 1px solid var(--border-gold);
  padding: 14px 0;
  margin-bottom: 20px;
}
.bundle-price {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 800;
  color: var(--gold-light);
}
.bundle-price-old {
  font-size: 13px;
  color: var(--slate-deep);
  text-decoration: line-through;
}
.bundle-benefits {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}
.bundle-benefits li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: #c8d2e1;
}
.bundle-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgba(197,160,89,0.15);
  color: var(--gold-light);
  font-size: 11px;
  flex-shrink: 0;
}
.bundle-actions { display: flex; flex-direction: column; gap: 10px; margin-top: auto; }
.bundle-order-btn { width: 100%; justify-content: center; padding: 14px; font-size: 11px; }
.bundle-wa-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  border-radius: 12px;
  border: 1px solid rgba(197,160,89,0.4);
  background: var(--bg-deep);
  padding: 12px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-light);
  transition: background 0.3s;
}
.bundle-wa-btn:hover { background: rgba(197,160,89,0.15); }
</style>

<script>
async function handleBundleCheckout(e, variantId, qty) {
  e.preventDefault();
  var btn = e.target.querySelector('button[type="submit"]');
  if (btn) {
    btn.style.opacity = '0.7';
    btn.innerHTML = '<span>ADDING TO CART...</span>';
  }
  try {
    await fetch('/cart/clear.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    var res = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: qty })
    });
    if (res.ok) {
      window.location.href = '/cart';
    } else {
      window.location.href = '/cart/' + variantId + ':' + qty;
    }
  } catch (err) {
    window.location.href = '/cart';
  }
}
</script>

