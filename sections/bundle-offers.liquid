{% assign prod = all_products['midnight-drive-by-mens-aura'] %}
{% if prod == blank or prod.id == blank %}{% assign prod = all_products['midnight-drive'] %}{% endif %}
{% if prod == blank or prod.id == blank %}{% assign prod = collections.all.products.first %}{% endif %}
{% assign v1 = prod.variants[0] %}
{% assign v2 = prod.variants[1] %}
{% assign v3 = prod.variants[2] %}

{% for v in prod.variants %}
  {% if v.title contains '3' or v.title contains 'Master' %}
    {% assign v3 = v %}
  {% elsif v.title contains '2' or v.title contains 'Pack' %}
    {% assign v2 = v %}
  {% elsif v.title contains '1' or v.title contains 'Starter' %}
    {% assign v1 = v %}
  {% endif %}
{% endfor %}

{% assign v1_id = section.settings.variant_id_1 | default: v1.id | default: 52658897912110 %}
{% assign v2_id = section.settings.variant_id_2 | default: v2.id | default: v1_id %}
{% assign v3_id = section.settings.variant_id_3 | default: v3.id | default: v1_id %}
{% assign variant_id = v1_id %}
{% assign product_url = prod.url | default: '/products/midnight-drive-by-mens-aura' %}

