<style>
.sensation-tab {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border-radius: 16px;
  border: 1px solid rgba(197,160,89,0.25);
  background: #090e17;
  padding: 10px 16px;
  color: var(--slate);
  cursor: pointer;
  transition: all 0.3s;
}
.sensation-tab:hover { border-color: rgba(197,160,89,0.5); color: var(--cream); }
.sensation-tab--active { border-color: var(--gold); background: var(--gold); color: var(--bg-deep); box-shadow: 0 0 25px rgba(197,160,89,0.35); transform: scale(1.05); }
.sensation-tab-icon {
  width: 28px; height: 28px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(197,160,89,0.15);
}
.sensation-tab--active .sensation-tab-icon { background: var(--bg-deep); color: var(--gold-light); }
.sensation-panel { display: none; }
.sensation-panel--visible { display: block; animation: fadeInUp 0.3s ease; }
.sensation-card {
  border-radius: 24px;
  border: 1px solid rgba(197,160,89,0.3);
  background: linear-gradient(135deg, #0a101c 0%, #070b12 50%, #0a101c 100%);
  padding: 32px;
  box-shadow: 0 25px 80px rgba(0,0,0,0.5);
}
.sensation-card-icon {
  width: 48px; height: 48px; border-radius: 14px;
  border: 1px solid rgba(197,160,89,0.4);
  background: rgba(197,160,89,0.15);
  display: flex; align-items: center; justify-content: center;
  color: var(--gold-light);
  box-shadow: 0 0 20px rgba(197,160,89,0.2);
}
.sensation-effect-pill {
  display: flex; align-items: center; gap: 8px;
  border-radius: 12px; border: 1px solid rgba(197,160,89,0.15);
  background: #070b12; padding: 10px 14px;
  font-size: 12px; color: var(--cream);
}
.sensation-effect-pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
</style>

<script>
function switchSensation(idx) {
  document.querySelectorAll('.sensation-tab').forEach(function(t, i) {
    t.classList.toggle('sensation-tab--active', i === idx);
  });
  document.querySelectorAll('.sensation-panel').forEach(function(p, i) {
    p.classList.toggle('sensation-panel--visible', i === idx);
  });
}
</script>

