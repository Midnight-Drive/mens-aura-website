<!-- 404 Page Section -->
<section class="page-404 section-pad" style="background:var(--bg-deep);min-height:70vh;display:flex;align-items:center;">
  <div class="container" style="text-align:center;">
    <div style="font-family:var(--font-heading);font-size:72px;font-weight:800;color:var(--gold);line-height:1;">404</div>
    <h1 style="font-family:var(--font-serif);font-size:32px;font-weight:600;color:var(--cream);margin-top:16px;">Page Not Found</h1>
    <p style="font-size:14px;color:var(--slate);margin-top:12px;max-width:480px;margin-left:auto;margin-right:auto;line-height:1.7;">
      The requested page could not be located. Return to the home ritual to explore Midnight Drive.
    </p>
    <div style="margin-top:32px;">
      <a href="/" class="gold-glow-button" style="display:inline-flex;padding:14px 28px;font-size:11px;">
        Return to Home
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "class": "page-404-section",
  "tag": "div",
  "settings": []
}
{% endschema %}
