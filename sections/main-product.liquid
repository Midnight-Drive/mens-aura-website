<!-- Main Product Section -->
{% assign prod = product %}
{% if prod == blank or prod.id == blank %}{% assign prod = all_products['midnight-drive-by-mens-aura'] %}{% endif %}
{% if prod == blank or prod.id == blank %}{% assign prod = all_products['midnight-drive'] %}{% endif %}
{% if prod == blank or prod.id == blank %}{% assign prod = collections.all.products.first %}{% endif %}
{% assign v1 = prod.variants[0] %}
{% assign v2 = prod.variants[1] %}
{% assign v3 = prod.variants[2] %}

{% for v in prod.variants %}
  {% if v.title contains '3' or v.title contains 'Master' %}
    {% assign v3 = v %}
  {% elsif v.title contains '2' or v.title contains 'Pack' %}
    {% assign v2 = v %}
  {% elsif v.title contains '1' or v.title contains 'Starter' %}
    {% assign v1 = v %}
  {% endif %}
{% endfor %}

{% assign v1_id = section.settings.bundle_1_variant_id | default: v1.id | default: 52658897912110 %}
{% assign v2_id = section.settings.bundle_2_variant_id | default: v2.id | default: v1_id %}
{% assign v3_id = section.settings.bundle_3_variant_id | default: v3.id | default: v1_id %}
{% assign variant_id = v1_id %}

{% assign video_src = section.settings.product_video_url %}
{% if video_src == blank %}
  {% assign video_src = 'product-page-video.mp4' | asset_url %}
{% endif %}
{% assign cta_btn_text = section.settings.cta_button_text | default: 'ADD TO CART' %}

