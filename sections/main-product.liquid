            <div style="border-bottom:1px solid rgba(197,160,89,0.15);padding-bottom:8px;">
              <span style="font-family:var(--font-mono);font-size:10px;text-transform:uppercase;color:var(--slate);display:block;">Packaging</span>
              <strong style="font-size:13px;color:var(--cream);">Premium Amber Glass Bottle</strong>
            </div>
            <div style="border-bottom:1px solid rgba(197,160,89,0.15);padding-bottom:8px;">
              <span style="font-family:var(--font-mono);font-size:10px;text-transform:uppercase;color:var(--slate);display:block;">Retail Price</span>
              <strong style="font-size:13px;color:var(--gold-light);">Rs. 2,499 <span style="font-size:11px;color:var(--slate);text-decoration:line-through;">(MRP: Rs. 3,000)</span></strong>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
.product-bundle-option {
  border-radius: 16px;
  border: 1px solid rgba(197,160,89,0.2);
  background: #090e17;
  padding: 14px 18px;
  cursor: pointer;
  transition: all 0.3s;
}
.product-bundle-option:hover {
  border-color: rgba(197,160,89,0.5);
  background: #0e1524;
}
.product-bundle-option--selected {
  border: 2px solid var(--gold);
  background: linear-gradient(135deg, #101828 0%, #090e17 100%);
  box-shadow: 0 0 25px rgba(197,160,89,0.2);
}
.bundle-radio-circle {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid rgba(197,160,89,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
}
.product-bundle-option--selected .bundle-radio-circle {
  border-color: var(--gold);
  background: var(--gold);
}
.product-bundle-option--selected .bundle-radio-circle::after {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--bg-deep);
}
</style>

<script>
function selectProductQty(qty, price, title, variantId) {
  var list = document.querySelectorAll('.product-bundle-option');
  list.forEach(function(item, index) {
    item.classList.toggle('product-bundle-option--selected', index === (qty - 1));
  });

  var qtyInput = document.getElementById('product-selected-qty');
  var varInput = document.getElementById('product-variant-id');
  var v1Id = '{{ v1_id }}';
  
  if (variantId && variantId !== v1Id) {
    if (varInput) varInput.value = variantId;
    if (qtyInput) qtyInput.value = 1;
  } else {
    if (varInput) varInput.value = variantId || v1Id;
    if (qtyInput) qtyInput.value = qty;
  }

  var btnText = document.getElementById('checkout-btn-text');
  var baseAction = "{{ cta_btn_text }}";
  if (btnText) btnText.textContent = baseAction + ' — PKR ' + price.toLocaleString() + ' (COD)';

  var waBtn = document.getElementById('product-wa-order-btn');
  if (waBtn) {
    var message = "Hello The Men's Aura Support, I want to order " + title + " (Total: PKR " + price.toLocaleString() + ") Cash on Delivery. Please confirm my order.";
    waBtn.href = 'https://wa.me/923110355309?text=' + encodeURIComponent(message);
  }
}

async function handleProductCheckout(e) {
  e.preventDefault();
  var btn = document.getElementById('direct-checkout-btn');
  var btnText = document.getElementById('checkout-btn-text');
  var variantId = document.getElementById('product-variant-id').value;
  var qty = parseInt(document.getElementById('product-selected-qty').value, 10) || 1;
  
  if (btn) btn.style.opacity = '0.7';
  if (btnText) btnText.textContent = 'ADDING TO CART...';

  try {
    await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: qty })
    });
    window.location.href = '/cart';
  } catch (err) {
    window.location.href = '/cart/' + variantId + ':' + qty;
  }
}
</script>

{% schema %}
{
  "name": "Main Product",
  "class": "main-product-section",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "Button Action Text",
      "default": "ADD TO CART",
      "info": "Text displayed on the action button (e.g. 'ADD TO CART' or 'ORDER NOW')"
    },
    {
      "type": "text",
      "id": "product_video_url",
      "label": "Product Video URL (.mp4)",
      "info": "Leave blank to use theme asset 'product-page-video.mp4', or paste a direct video link from Shopify Admin > Content > Files."
    },
    {
      "type": "text",
      "id": "bundle_1_variant_id",
      "label": "Bundle 1 Variant ID (1 Bottle - PKR 2,499)",
      "default": "52658897912110"
    },
    {
      "type": "text",
      "id": "bundle_2_variant_id",
      "label": "Bundle 2 Variant ID (2 Bottles Pack - PKR 4,499)",
      "info": "Variant ID for 2 Bottles Pack from Shopify Admin (leave blank to auto-detect)"
    },
    {
      "type": "text",
      "id": "bundle_3_variant_id",
      "label": "Bundle 3 Variant ID (3 Bottles Master Pack - PKR 5,999)",
      "info": "Variant ID for 3 Bottles Master Pack from Shopify Admin (leave blank to auto-detect)"
    }
  ]
}
{% endschema %}
