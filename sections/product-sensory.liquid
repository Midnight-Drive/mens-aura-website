<style>
.week-btn {
  border-radius: 100px;
  border: none;
  background: transparent;
  padding: 6px 16px;
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--slate);
  cursor: pointer;
  transition: all 0.3s;
}
.week-btn:hover { color: var(--cream); }
.week-btn--active {
  background: var(--gold);
  color: var(--bg-deep);
  font-weight: 700;
  box-shadow: 0 0 15px rgba(197,160,89,0.4);
}
.week-panel { display: none; }
.week-panel--active { display: block; animation: fadeInUp 0.3s ease; }
.week-metric-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  border-radius: 12px;
  border: 1px solid rgba(197,160,89,0.2);
  background: #0e1624;
  padding: 8px 14px;
  font-size: 12px;
  color: #c7d0de;
}
</style>

<script>
function switchWeek(w) {
  document.querySelectorAll('.week-btn').forEach(function(b) {
    b.classList.toggle('week-btn--active', parseInt(b.getAttribute('data-week')) === w);
  });
  document.querySelectorAll('.week-panel').forEach(function(p) {
    p.classList.remove('week-panel--active');
  });
  var target = document.getElementById('week-panel-' + w);
  if (target) target.classList.add('week-panel--active');
}
</script>

