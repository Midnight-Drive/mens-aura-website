{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); try{fs.unlinkSync('package-lock.json');}catch(e){} try{fs.unlinkSync('yarn.lock');}catch(e){}\"",
    "build": "pnpm run typecheck && pnpm -r --filter @workspace/mens-aura run build && node -e \"const fs=require('fs'); fs.mkdirSync('dist',{recursive:true}); try{fs.cpSync('artifacts/mens-aura/dist','dist',{recursive:true});}catch(e){}\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@esbuild/win32-x64": "^0.27.3",
    "@replit/connectors-sdk": "^0.4.1",
    "@rollup/rollup-win32-x64-msvc": "^4.62.5",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "@types/three": "^0.185.4",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@rollup/rollup-win32-x64-msvc",
      "@tailwindcss/oxide-win32-x64-msvc",
      "lightningcss-win32-x64-msvc",
      "@swc/core",
      "sharp"
    ]
  }
}
